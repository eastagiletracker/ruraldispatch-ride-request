{
  "name": "ride-request-app",
  "version": "2.0.0",
  "description": "A modern ride request application with client and server",
  "main": "server/index.js",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server/index.js",
    "client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "start": "node server/index.js",
    "install-all": "npm install && cd client && npm install && cd ../ && cd shared && npm install",
    "seed": "node server/seed/seed.js",
    "seed:all": "node server/seed/seed.js",
    "seed:admins": "node server/seed/seedAdmins.js",
    "seed:dispatchers": "node server/seed/seedDispatchers.js",
    "seed:case-managers": "node server/seed/seedCaseManagers.js",
    "seed:riders": "node server/seed/seedRiders.js",
    "seed:caregivers": "node server/seed/seedCaregivers.js",
    "seed:drivers": "node server/seed/seedDrivers.js",
    "seed:vehicles": "node server/seed/seedVehicles.js",
    "seed:rides": "node server/seed/seedRides.js",
    "seed:reset": "node server/seed/reset.js",
    "seed:prod": "NODE_ENV=production node server/seed/seed.js",
    "seed:prod:reset": "NODE_ENV=production node server/seed/reset.js",
    "seed:staging": "NODE_ENV=staging node server/seed/seed.js",
    "seed:staging:reset": "NODE_ENV=staging node server/seed/reset.js"
  },
  "dependencies": {
    "@vonage/server-sdk": "^3.25.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "moment-timezone": "^0.6.0",
    "mongoose": "^7.5.0",
    "morgan": "^1.10.0",
    "twilio": "^5.10.4"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "nodemon": "^3.0.1"
  },
  "keywords": [
    "ride",
    "request",
    "transportation",
    "fullstack",
    "mongodb"
  ],
  "author": "Your Name",
  "license": "MIT"
}

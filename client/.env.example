# ==========================================
# CLIENT FRONTEND ENVIRONMENT VARIABLES
# ==========================================
# Copy this file to .env and fill in your values
# Note: All variables must be prefixed with VITE_ to be accessible in the browser

# ==========================================
# GOOGLE MAPS API
# ==========================================
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ==========================================
# API BACKEND URL
# ==========================================
# For local development: http://localhost:5001
# For production: https://your-backend.onrender.com
VITE_API_URL=http://localhost:5001

# ==========================================
# DEPLOYMENT NOTES
# ==========================================
# 1. This .env file is separate from server-fastify/.env
# 2. VITE_GOOGLE_MAPS_API_KEY is required for address autocomplete
# 3. VITE_API_URL should point to your Fastify backend
# 4. All VITE_ prefixed variables are exposed to the browser (not secret!)
# 5. Never put sensitive keys here - they're visible in browser

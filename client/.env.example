# ==========================================
# CLIENT FRONTEND ENVIRONMENT VARIABLES
# ==========================================
# Copy this file to .env and fill in your values
# Note: All variables must be prefixed with VITE_ to be accessible in the browser

# ==========================================
# GOOGLE MAPS API
# ==========================================
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ==========================================
# API BACKEND URL (Production)
# ==========================================
# In production, set this to your Render backend URL
# In development, Vite proxy handles /api requests to localhost:5000
VITE_API_URL=https://your-backend.onrender.com

# ==========================================
# DEPLOYMENT NOTES
# ==========================================
# 1. VITE_GOOGLE_MAPS_API_KEY is required for address autocomplete
# 2. VITE_API_URL should point to your Fastify backend in production
# 3. All VITE_ prefixed variables are exposed to the browser (not secret!)
# 4. Never put sensitive keys here - they're visible in browser

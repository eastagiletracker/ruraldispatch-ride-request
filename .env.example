# PostgreSQL Configuration (Prisma 7 + Prisma Postgres Cloud)
# Get your connection string from: https://www.prisma.io/docs/postgres
# Format: postgresql://[KEY]:[SECRET]@db.prisma.io:5432/postgres?sslmode=require
DATABASE_URL="postgresql://your-key:your-secret@db.prisma.io:5432/postgres?sslmode=require"

# Server Configuration
NODE_ENV=development
PORT=5000

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Twilio Configuration
TWILIO_MESSAGING_SERVICE_SID=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
# Webhook for INCOMING SMS (Twilio sends incoming messages here)
TWILIO_WEBHOOK_URL="https://ruraldispatch.swarmnyc.com/api/notifications/webhook/twilio"
# Status callback for delivery receipts
TWILIO_STATUS_CALLBACK_URL="https://ruraldispatch.swarmnyc.com/api/notifications/status/twilio"
# Set to 'true' to disable status callbacks (messages will stay at 'sent' status)
# TWILIO_DISABLE_STATUS_CALLBACK="false"

# Vonage Configuration
VONAGE_API_KEY=""
VONAGE_API_SECRET=""
VONAGE_FROM_NUMBER=""
VONAGE_WEBHOOK_URL="https://ruraldispatch.swarmnyc.com/api/notifications/webhook/vonage"

# Google Maps API Configuration
# Get your API key from: https://console.cloud.google.com/google/maps-apis
# Make sure to enable:
# - Places API (New)
# - Maps JavaScript API
# - Distance Matrix API (for future use)
VITE_GOOGLE_MAPS_API_KEY='AIzaSyD4YoIrnXI3QPb7OKn8QSvFMN9DuWgY02I'


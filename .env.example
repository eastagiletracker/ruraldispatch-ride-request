# Server Configuration
MONGODB_URI="mongodb+srv://"

# Server Configuration
NODE_ENV=development
PORT=5000

# JWT Secret
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Twilio Configuration
TWILIO_MESSAGING_SERVICE_SID=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""
# Webhook for INCOMING SMS (Twilio sends incoming messages here)
TWILIO_WEBHOOK_URL="https://ruraldispatch.org/api/notifications/webhook/twilio"
# Status callback for delivery receipts (Twilio sends status updates here)
TWILIO_STATUS_CALLBACK_URL="https://ruraldispatch.org/api/notifications/status/twilio"
# Set to 'true' to disable status callbacks (messages will stay at 'sent' status)
# TWILIO_DISABLE_STATUS_CALLBACK="false"

# Vonage Configuration
VONAGE_API_KEY=""
VONAGE_API_SECRET=""
VONAGE_FROM_NUMBER=""
VONAGE_WEBHOOK_URL="https://ruraldispatch.org/api/notifications/webhook/vonage"

{
  "name": "ride-request-app",
  "version": "2.0.0",
  "description": "A modern ride request application with client and server",
  "type": "module",
  "main": "server/index.js",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0",
    "bun": ">=1.0.0"
  },
  "scripts": {
    "dev": "concurrently \"cd server-fastify && bun run dev\" \"bun run client\"",
    "dev:fastify": "cd server-fastify && bun run dev",
    "server": "cd server-fastify && bun run dev",
    "client": "cd client && bun run dev",
    "build": "cd client && bun run build",
    "build:server": "cd server-fastify && bun run build",
    "start": "cd server-fastify && bun start",
    "install-all": "bun install && cd client && bun install && cd ../shared && bun install && cd ../server-fastify && bun install",
    "seed": "cd server-fastify && bunx tsx prisma/seed.ts",
    "seed:reset": "cd server-fastify && bunx prisma migrate reset --force",
    "db:studio": "cd server-fastify && bunx prisma studio",
    "db:migrate": "cd server-fastify && bunx prisma migrate dev",
    "db:generate": "cd server-fastify && bunx prisma generate",
    "db:push": "cd server-fastify && bunx prisma db push",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "@vonage/server-sdk": "^3.25.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.16.3",
    "prisma": "^7.0.0",
    "twilio": "^5.10.4",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.6",
    "concurrently": "^8.2.0"
  },
  "keywords": [
    "ride",
    "request",
    "transportation",
    "fullstack",
    "postgresql",
    "prisma"
  ],
  "author": "Your Name",
  "license": "MIT"
}

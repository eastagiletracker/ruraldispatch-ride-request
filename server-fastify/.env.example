# ==========================================
# FASTIFY SERVER ENVIRONMENT VARIABLES
# ==========================================
# Copy this file to .env and fill in your values
# Note: This .env file is separate from client/.env

# ==========================================
# SERVER CONFIGURATION
# ==========================================
NODE_ENV=development
PORT=5001

# ==========================================
# DATABASE (PostgreSQL via Prisma)
# ==========================================
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://postgres:password@localhost:5432/rural_dispatch

# ==========================================
# CORS & CLIENT
# ==========================================
# For local development: http://localhost:3001 (client dev server port)
# For production: https://your-frontend-domain.com
CLIENT_URL=http://localhost:3001

# ==========================================
# TWILIO SMS (Primary Provider)
# ==========================================
TWILIO_MESSAGING_SERVICE_SID=your_messaging_service_sid_here
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WEBHOOK_URL=https://yourdomain.com/api/notifications/webhook/twilio
TWILIO_STATUS_CALLBACK_URL=https://yourdomain.com/api/notifications/status/twilio

# ==========================================
# VONAGE SMS (Fallback Provider)
# ==========================================
VONAGE_API_KEY=your_vonage_api_key_here
VONAGE_API_SECRET=your_vonage_api_secret_here
VONAGE_FROM_NUMBER=+1234567890
VONAGE_WEBHOOK_URL=https://yourdomain.com/api/notifications/webhook/vonage

# ==========================================
# GOOGLE MAPS API
# ==========================================
GOOGLE_MAPS_SERVER_API_KEY=your_google_maps_api_key_here

# ==========================================
# JWT (Future Implementation)
# ==========================================
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# ==========================================
# LOGGING & MONITORING
# ==========================================
# Leave blank for production (uses JSON logging)
# Set to 'pino-pretty' for development pretty logs (already configured in code)

# ==========================================
# DEPLOYMENT NOTES
# ==========================================
# ENVIRONMENT STRUCTURE:
# - Client environment variables are in client/.env
# - Server environment variables are in server-fastify/.env (this file)
# - Each folder has its own .env file with only necessary variables
#
# RENDER/PRODUCTION DEPLOYMENT:
# 1. Set NODE_ENV=production on Render
# 2. Add DATABASE_URL from Render PostgreSQL add-on
# 3. Set all SMS provider credentials as environment variables
# 4. Update webhook URLs to match your Render domain
# 5. CLIENT_URL should be your frontend domain (e.g., https://yourdomain.com)
# 6. Add TZ=UTC for consistent timezone handling
